# Server-only story generation settings. Never use VITE_ prefixes for secrets.
# Set these in .env.local for `vercel dev` and in Vercel project environments.
# Built-in stories and local editor/playback need no API key.
OPENAI_API_KEY=
STORY_MODEL=gpt-4o-mini

# Production requires shared Redis rate limiting; development uses a local quota.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=

# Optional approved-source token signing secret; defaults to OPENAI_API_KEY.
# Rotating this invalidates old reading-age adaptation tokens, not local playback.
STORY_SIGNING_SECRET=
