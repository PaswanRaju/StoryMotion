# Server-only secret for the optional Meta dialogue proxy (api/meta-dialogue.ts).
# NEVER prefix with VITE_ — that would bundle it into client-side code.
# NEVER commit the real value. Set it in your local shell/.env and in Vercel's
# project environment variables (Settings > Environment Variables) for deploys.
MODEL_API_KEY=

# Meta model identifier for dialogue generation. Confirm the current official
# model ID at https://dev.meta.ai/docs/models before relying on this value —
# candidate at time of writing: muse-spark-1.3
META_MODEL_ID=

# Base URL for the Meta Model API. Confirm against current official docs.
META_API_BASE_URL=https://api.meta.ai/v1
